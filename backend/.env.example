# انسخ هذا الملف إلى .env على الخادم فقط. لا ترفع .env إلى GitHub.
PORT=3000
DB_PATH=./data.db

# أسرار: ولّدها عشوائياً (مثلاً: openssl rand -hex 32)
JWT_SECRET=
POSTBACK_SECRET=
ADMIN_KEY=

# حصة المستخدم من عمولة الشبكة (0.6 = 60%) وأقل مبلغ للسحب بالدولار
REWARD_SHARE=0.6
MIN_WITHDRAW=5

# رابط جدار العروض من لوحة CPAlead أو Pollfish، ضع {uid} مكان معرّف المستخدم
# مثال: https://YOUR-OFFERWALL-URL?subid={uid}
OFFERWALL_URL_TEMPLATE=

# PayPal Payouts (ابدأ بـ sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
